<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 仅「设置 → 检查更新」下载公共包后调用系统安装器；不会静默安装。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      位置权限：**可选功能**，默认关闭。
      仅当用户在设置里主动开启「定位当前城市」并点击定位按钮时才申请；
      默认只使用粗略位置；用户主动开启街道级定位时才申请精确位置。
      始终不申请后台位置。
      拒绝后 App 全部功能照常可用（手动搜索城市）。
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Only discover calendar entry points; no calendar data permission needed. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CALENDAR" />
        </intent>
    </queries>

    <application
        android:name=".ZhishengApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher_character"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_character_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZhishengWeather">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
        </activity>

        <!--
          桌面图标通过互斥 activity-alias 切换。先启用目标别名、再禁用旧别名，
          可在不重装 App 的前提下刷新桌面入口；默认使用角色图标。
        -->
        <activity-alias
            android:name=".IconCharacter"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_character"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_character_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity android:name=".widget.WidgetConfigActivity" android:exported="true" android:label="桌面天气">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <activity android:name=".widget.WidgetLaunchActivity" android:exported="false" android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <receiver android:name=".widget.WidgetPinReceiver" android:exported="false" />
        <receiver android:name=".widget.FreshWidgetProvider" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.WALLPAPER_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver android:name=".widget.VistaPulseWidgetProvider" android:label="枳生天气 · 澄空 · 时光气象" android:exported="false"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_vista_pulse" /></receiver>
        <receiver android:name=".widget.VistaNowWidgetProvider" android:label="枳生天气 · 澄空 · 天气小窗" android:exported="false"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_vista_now" /></receiver>
        <receiver android:name=".widget.VistaBandWidgetProvider" android:label="枳生天气 · 澄空 · 逐时天光" android:exported="false"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_vista_band" /></receiver>
        <receiver android:name=".widget.VistaWeekWidgetProvider" android:label="枳生天气 · 澄空 · 日历天气" android:exported="false"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_vista_week" /></receiver>
        <receiver android:name=".widget.VistaSceneWidgetProvider" android:label="枳生天气 · 澄空 · 天气全景" android:exported="false"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_vista_scene" /></receiver>
        <receiver android:name=".widget.ClassicPulseWidgetProvider" android:label="枳生天气 · 经典 · 时间信号" android:exported="false"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_classic_pulse" /></receiver>
        <receiver android:name=".widget.ClassicNowWidgetProvider" android:label="枳生天气 · 经典 · 微型观测站" android:exported="false"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_classic_now" /></receiver>
        <receiver android:name=".widget.ClassicBandWidgetProvider" android:label="枳生天气 · 经典 · 出行监测" android:exported="false"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_classic_band" /></receiver>
        <receiver android:name=".widget.ClassicWeekWidgetProvider" android:label="枳生天气 · 经典 · 五日趋势" android:exported="false"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_classic_week" /></receiver>
        <receiver android:name=".widget.ClassicSceneWidgetProvider" android:label="枳生天气 · 经典 · 气象终端" android:exported="false"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_classic_scene" /></receiver>

        <activity-alias
            android:name=".IconClassic"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".IconLight"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_light"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_light_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

    </application>

</manifest>
