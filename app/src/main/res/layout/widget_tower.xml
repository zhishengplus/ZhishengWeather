<?xml version="1.0" encoding="utf-8"?>
<!-- Hallmark · pre-emit critique: P5 H5 E4 S5 R5 V4 · 2x4 liquid vertical instrument. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="6dp"
    android:paddingVertical="10dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widget_accent_bar" android:layout_width="2dp" android:layout_height="22dp" android:background="@drawable/widget_accent" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/w_city" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:maxLines="1" android:text="@string/widget_name" android:textColor="@color/widget_text_primary" android:textSize="15sp" android:textStyle="bold" />
                <ImageView android:id="@+id/widget_live_dot" android:layout_width="6dp" android:layout_height="6dp" android:layout_marginStart="4dp" android:contentDescription="@null" android:src="@drawable/widget_live_dot" />
            </LinearLayout>
            <TextView android:id="@+id/w_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="monospace" android:maxLines="1" android:text="@string/widget_date_placeholder" android:textColor="@color/widget_text_tertiary" android:textSize="9sp" />
        </LinearLayout>
        <TextView android:id="@+id/w_refresh" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:fontFamily="monospace" android:maxLines="1" android:text="@string/widget_refresh_glyph" android:textColor="@color/widget_accent_cyan" android:textSize="18sp" android:contentDescription="@string/widget_refresh_desc" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/w_temp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" android:text="@string/widget_value_placeholder" android:textColor="@color/widget_text_primary" android:textSize="54sp" android:textStyle="bold" />
        <ImageView android:id="@+id/w_icon" android:layout_width="58dp" android:layout_height="58dp" android:layout_marginEnd="6dp" android:contentDescription="@string/widget_icon_desc" android:src="@drawable/weather_cloud" />
    </LinearLayout>

    <TextView android:id="@+id/w_range" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:maxLines="2" android:text="@string/widget_value_placeholder" android:textColor="@color/widget_text_secondary" android:textSize="14sp" />
    <TextView android:id="@+id/widget_rule_bar" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:layout_marginBottom="8dp" android:background="@drawable/widget_rule" />
    <TextView android:id="@+id/w_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:fontFamily="monospace" android:maxLines="2" android:text="@string/widget_details_placeholder" android:textColor="@color/widget_text_secondary" android:textSize="11sp" />
    <TextView android:id="@+id/w_aux" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:ellipsize="end" android:fontFamily="monospace" android:maxLines="2" android:textColor="@color/widget_accent_cyan" android:textSize="10sp" android:visibility="gone" />
    <TextView android:id="@+id/w_upd" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:fontFamily="monospace" android:gravity="start" android:maxLines="1" android:text="@string/widget_update_placeholder" android:textColor="@color/widget_text_tertiary" android:textSize="9sp" />
</LinearLayout>
