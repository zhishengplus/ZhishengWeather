<?xml version="1.0" encoding="utf-8"?>
<!-- Hallmark · pre-emit critique: P5 H5 E4 S5 R5 V4 · 4x4 liquid weather workstation. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="8dp"
    android:paddingVertical="8dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widget_accent_bar" android:layout_width="2dp" android:layout_height="18dp" android:background="@drawable/widget_accent" />
        <TextView android:id="@+id/w_city" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:maxLines="1" android:text="@string/widget_name" android:textColor="@color/widget_text_primary" android:textSize="16sp" android:textStyle="bold" />
        <ImageView android:id="@+id/widget_live_dot" android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="7dp" android:contentDescription="@null" android:src="@drawable/widget_live_dot" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="end" android:orientation="vertical">
            <TextView android:id="@+id/w_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="monospace" android:maxLines="1" android:text="@string/widget_date_placeholder" android:textColor="@color/widget_text_secondary" android:textSize="9sp" />
            <TextView android:id="@+id/w_upd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="monospace" android:maxLines="1" android:text="@string/widget_update_placeholder" android:textColor="@color/widget_text_tertiary" android:textSize="8sp" />
        </LinearLayout>
        <TextView android:id="@+id/w_refresh" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:fontFamily="monospace" android:maxLines="1" android:text="@string/widget_refresh_glyph" android:textColor="@color/widget_accent_cyan" android:textSize="18sp" android:contentDescription="@string/widget_refresh_desc" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="68dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/w_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="monospace" android:includeFontPadding="false" android:maxLines="1" android:text="@string/widget_value_placeholder" android:textColor="@color/widget_text_primary" android:textSize="50sp" android:textStyle="bold" />
        <ImageView android:id="@+id/w_icon" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="3dp" android:contentDescription="@string/widget_icon_desc" android:src="@drawable/weather_cloud" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/w_range" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:maxLines="1" android:text="@string/widget_value_placeholder" android:textColor="@color/widget_text_secondary" android:textSize="14sp" />
            <TextView android:id="@+id/w_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:fontFamily="monospace" android:maxLines="2" android:text="@string/widget_details_placeholder" android:textColor="@color/widget_text_tertiary" android:textSize="10sp" />
            <TextView android:id="@+id/w_aqi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFamily="monospace" android:maxLines="1" android:text="@string/widget_aqi_placeholder" android:textColor="@color/widget_accent_cyan" android:textSize="10sp" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/widget_rule_bar" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="2dp" android:layout_marginBottom="3dp" android:background="@drawable/widget_rule" />
    <LinearLayout android:id="@+id/w_trend_section" android:layout_width="match_parent" android:layout_height="55dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="17dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/w_trend_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="monospace" android:text="@string/widget_trend_label" android:textColor="@color/widget_text_tertiary" android:textSize="9sp" />
            <TextView android:id="@+id/w_trend_range" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="monospace" android:text="@string/widget_range_placeholder" android:textColor="@color/widget_accent_cyan" android:textSize="9sp" />
        </LinearLayout>
        <ImageView android:id="@+id/w_temp_trend" android:layout_width="match_parent" android:layout_height="38dp" android:contentDescription="@string/widget_trend_desc" android:scaleType="fitXY" />
    </LinearLayout>

    <LinearLayout android:id="@+id/w_life_section" android:layout_width="match_parent" android:layout_height="26dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/w_life_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="monospace" android:text="@string/widget_life_label" android:textColor="@color/widget_accent_orange" android:textSize="9sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_life_line" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:layout_weight="1" android:ellipsize="end" android:fontFamily="monospace" android:maxLines="1" android:textColor="@color/widget_text_secondary" android:textSize="10sp" />
    </LinearLayout>

    <TextView android:id="@+id/widget_rule_bar_2" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginBottom="2dp" android:background="@drawable/widget_rule" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
        <include layout="@layout/widget_day_1" />
        <include layout="@layout/widget_day_2" />
        <include layout="@layout/widget_day_3" />
        <include layout="@layout/widget_day_4" />
        <include layout="@layout/widget_day_5" />
        <include layout="@layout/widget_day_6" />
        <include layout="@layout/widget_day_7" />
    </LinearLayout>
</LinearLayout>
