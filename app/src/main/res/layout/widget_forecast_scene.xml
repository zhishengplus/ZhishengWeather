<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_forecast_cell" android:layout_width="0dp" android:layout_height="match_parent" android:orientation="vertical" android:layout_weight="1" android:gravity="center">
<TextView android:id="@+id/widget_cell_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#1B3346" android:fontFamily="sans-serif" android:textStyle="bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center">
</TextView>
<ImageView android:id="@+id/widget_cell_icon" android:layout_width="34dp" android:layout_height="34dp" android:scaleType="fitCenter" android:contentDescription="" android:layout_marginTop="1dp">
</ImageView>
<TextView android:id="@+id/widget_cell_temp" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="#1B3346" android:fontFamily="sans-serif" android:textStyle="bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="1dp" android:gravity="center">
</TextView>
</LinearLayout>
